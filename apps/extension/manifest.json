{
  "manifest_version": 3,
  "name": "Download IT",
  "version": "0.1.0",
  "minimum_chrome_version": "116",
  "description": "Save authorized YouTube media with your Download IT companion.",
  "key": "",
  "permissions": [
    "storage",
    "nativeMessaging"
  ],
  "action": {
    "default_title": "Download IT"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://music.youtube.com/*",
        "https://m.youtube.com/*"
      ],
      "js": [
        "content.js"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'; connect-src 'none'; frame-src 'none'"
  }
}
